{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": ["explore", "execute", "review"]
          },
          "objective": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "model": { "type": "string" },
          "reasoning_effort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh"]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 86400
          },
          "allowed_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "prohibited_actions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "success_criteria": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "id",
          "kind",
          "objective",
          "dependencies",
          "model",
          "reasoning_effort",
          "timeout_seconds",
          "allowed_paths",
          "prohibited_actions",
          "success_criteria"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "tasks"],
  "additionalProperties": false
}
